# Neon connection string (Postgres). Example:
# postgres://USER:PASSWORD@HOST.neon.tech/SVFIT?sslmode=require
DATABASE_URL=

# Strong random string, e.g. 32+ chars
JWT_SECRET=

# Comma-separated allowed origins for CORS (frontend domains).
# Example: https://svfit.vercel.app,http://localhost:5173
FRONTEND_ORIGINS=https://svfit.vercel.app,http://localhost:5173

NODE_ENV=development
